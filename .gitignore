# ═══════════════════════════════════════════════
# Claude Code Settings — .gitignore
# Repo: artvision-agency/claude-code-settings
# ═══════════════════════════════════════════════

# ── Секреты и токены ──
.secrets
*.secret
*.token
.credentials.json
github_token

# ── Приватные/локальные данные ──
projects/
history.jsonl
.claude.json

# ── Ephemeral / session-specific ──
sessions/
session_logs/
session-env/
security_warnings_state_*.json
.update.lock
*.log
*.tmp
.DS_Store

# Auto-generated hook output (никогда не коммитим)
smoothing-reports/
learning-queue/
latency.csv
.account-alert-sent
.last_local_session
account-usage.json
scheduled_tasks.lock

# Telethon / SQLite session state (эфемерные)
*.session
*.session-shm
*.session-wal

# Backup directories (временные)
.backups-*/
settings.json.bak-*
settings.json.bak_*

# Runtime state / эфемерные каталоги
handovers/.pending/
channels/
exports/
logs/
state/*.bak
state/*.dead-*

# External plugin symlinks (ломаются на другой машине)
skills/gsap
skills/hyperframes
skills/hyperframes-cli
skills/hyperframes-registry
skills/website-to-hyperframes

# ── Кэши ──
cache/
paste-cache/
image-cache/
mcp-needs-auth-cache.json
stats-cache.json
*.cache

# ── IDE / debug / telemetry ──
debug/
file-history/
shell-snapshots/
statsig/
telemetry/
ide/

# ── Ephemeral runtime ──
todos/
commands/
tasks/
teams/
plans/
downloads/
backups/
plugins/

# ── Локальные конфиги (не синхронизировать) ──
settings.local.json
settings.json.bak
claude_desktop_config.json
CLAUDE.md.save
*.local
*.sync-all-sessions.sh.local

# ── Legacy / бэкапы ──
agents-backup-*/
agents-artvision

# ═══════════════════════════════════════════════
# СИНХРОНИЗИРУЕМ (НЕ в gitignore):
#   agents/           — агенты
#   hooks/            — хуки
#   rules/            — правила (workflow, git, tokens, security)
#   scripts/          — скрипты
#   skills/           — скиллы
#   tools/            — кастомные инструменты
#   settings.json     — плагины и настройки
#   CLAUDE.md         — глобальные инструкции
#   *.md              — документация
#   wp-sites.json     — конфиг сайтов
#   session-aliases.json — алиасы сессий
#   statusline.sh     — статусбар
# ═══════════════════════════════════════════════
voice/venv/
__pycache__/
secure-backups/
