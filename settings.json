  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd ~/artvision-data 2>/dev/null && git pull --quiet 2>/dev/null; echo '# Project Sync Status — artvision-data'; echo ''; cat ~/artvision-data/sync/SYNC_STATUS.md 2>/dev/null | head -80; echo ''; echo '---'; echo ''; cat ~/artvision-data/sync/QUICK_CONTEXT.md 2>/dev/null || echo 'Sync: no artvision-data context'",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/check-unsaved-artifacts.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/stop-quality-check.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/sync-all-repos.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-read.sh \"$CLAUDE_FILE_PATH\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-bash-check.sh \"$CLAUDE_BASH_COMMAND\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-push-summary.sh \"$CLAUDE_BASH_COMMAND\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/post-edit-lint.sh \"$CLAUDE_FILE_PATH\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/post-client-html-validate.sh \"$CLAUDE_FILE_PATH\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/post-edit-lint.sh \"$CLAUDE_FILE_PATH\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/post-client-html-validate.sh \"$CLAUDE_FILE_PATH\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-compact.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "github@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "supabase@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "asana@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "playground@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "huggingface-skills@claude-plugins-official": true
