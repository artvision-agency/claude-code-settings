{
  "enabledPlugins": {
    "github@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": true,
    "huggingface-skills@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": false,
    "supabase@claude-plugins-official": false,
    "agent-sdk-dev@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "asana@claude-plugins-official": false,
    "explanatory-output-style@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": false,
    "full-stack-orchestration@wshobson-agents": false,
    "conductor@wshobson-agents": false,
    "agent-orchestration@wshobson-agents": false,
    "comprehensive-review@wshobson-agents": false,
    "debugging-toolkit@wshobson-agents": false,
    "security-scanning@wshobson-agents": false,
    "cicd-automation@wshobson-agents": false,
    "deployment-strategies@wshobson-agents": false,
    "backend-development@wshobson-agents": false,
    "python-development@wshobson-agents": false,
    "javascript-typescript@wshobson-agents": false,
    "database-design@wshobson-agents": false,
    "kubernetes-operations@wshobson-agents": false,
    "data-engineering@wshobson-agents": false
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd ~/artvision-data 2>/dev/null && git pull --quiet 2>/dev/null; echo '# Project Sync Status — artvision-data'; echo ''; cat ~/artvision-data/sync/SYNC_STATUS.md 2>/dev/null | head -80; echo ''; echo '---'; echo ''; cat ~/artvision-data/sync/QUICK_CONTEXT.md 2>/dev/null || echo 'Sync: no artvision-data context'",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd ~/artvision-data 2>/dev/null && git add sync/ 2>/dev/null && git diff --cached --quiet || (git commit -m \"sync: auto $(date +%Y-%m-%d_%H:%M)\" --no-verify 2>/dev/null && git push --quiet 2>/dev/null); echo \"[$(date '+%Y-%m-%d %H:%M')] Session stop\" >> ~/.claude/session_logs/sessions.log",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-read.sh \"$CLAUDE_FILE_PATH\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
